{
  // SOC 2 §1.8 dependency-vulnerability merge gate for the Docusaurus site.
  // Fails on high + critical advisories, matching the previous
  // `npm audit --audit-level=high` gate — except entries in `allowlist`.
  //
  // Allowlisted advisories are documented, accepted risks. Each MUST be a
  // transitive advisory with no available fix within the current dependency
  // constraints; re-review whenever the dependency tree changes.
  "high": true,
  "allowlist": [
    // picomatch <=4.0.7 (transitive via @docusaurus/utils' micromatch,
    // chokidar/anymatch, tinyglobby/fdir, readdirp and jest-util). No patched
    // release exists at any published version (latest 4.0.7 is still in the
    // vulnerable range) as of 2026-11. ReDoS via single-branch repeated
    // extglobs; picomatch here only ever receives the fixed glob patterns
    // Docusaurus's own plugins use for build-time file discovery and
    // dev-server watching, never user-controlled input, so the ReDoS surface
    // is not reachable. Remove once a patched picomatch is published.
    "GHSA-fc5q-39xc-vjpf" // picomatch ReDoS through repeated extglobs
  ]
}
