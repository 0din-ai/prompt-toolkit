{
  "name": "@0din/prompt-toolkit",
  "version": "0.8.0",
  "description": "Multi-language SDK for LSH signature generation for AI prompt similarity detection",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "prepare": "tsc",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lsh",
    "locality-sensitive-hashing",
    "embeddings",
    "similarity",
    "ai",
    "typescript"
  ],
  "author": "0din Team",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/0din-ai/prompt-toolkit.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/0din-ai/prompt-toolkit/issues"
  },
  "homepage": "https://github.com/0din-ai/prompt-toolkit/tree/main/typescript",
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "onnxruntime-node": "^1.16.0",
    "openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    },
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.11",
    "typedoc": "^0.28.20"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
