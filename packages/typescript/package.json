{
  "name": "@0din/signature-sdk",
  "version": "0.1.1",
  "description": "Multi-language SDK for LSH signature generation for AI prompt similarity detection",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src test --ext .ts",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "lsh",
    "locality-sensitive-hashing",
    "embeddings",
    "similarity",
    "ai",
    "typescript"
  ],
  "author": "0din Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0din-ai/signature-sdk.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/0din-ai/signature-sdk/issues"
  },
  "homepage": "https://github.com/0din-ai/signature-sdk/tree/main/typescript",
  "peerDependencies": {
    "openai": "^4.0.0",
    "onnxruntime-node": "^1.16.0"
  },
  "peerDependenciesMeta": {
    "openai": {
      "optional": true
    },
    "onnxruntime-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
